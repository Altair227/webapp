{
  "allowCrossOrigin": true,
  "allowedOrigins": [
    "http://localhost:9000",
    "http://127.0.0.1:9000"
  ],
  "maxUploadFileSize": "512mb",
  "extensions": [
    "jpg", "jpeg", "png", "gif", "bmp", "ico", "svg", "webp", "tif", "psd", "ai",
    "ttf", "txt", "css", "ini", "xml", "csv", "rtf", "pdf",
    "doc", "docx", "xls", "xlsx", "pps", "ppt", "pptx", "odp",
    "zip", "rar", "7z", "gz", "tar",
    "mp4", "webm", "mov", "mkv", "avi", "3gp"
  ],
  "sources": {
    "default": {
      "title": "Upload",
      "root": "/app/files",
      "baseurl": "/upload/"
    }
  }
}
